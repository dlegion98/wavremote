<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal" android:padding="6dp">
    <LinearLayout android:id="@+id/w_guest" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/widget_btn_off"
        android:gravity="center" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Guest Wi-Fi" android:textColor="#F4F6FA" android:textSize="13sp" android:textStyle="bold"
            android:singleLine="true" />
        <TextView android:id="@+id/w_guest_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="–" android:textColor="#B6BFCC" android:textSize="12sp" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_kids" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/widget_btn_off"
        android:gravity="center" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Kids' Wi-Fi" android:textColor="#F4F6FA" android:textSize="13sp" android:textStyle="bold"
            android:singleLine="true" />
        <TextView android:id="@+id/w_kids_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="–" android:textColor="#B6BFCC" android:textSize="12sp" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_lights" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/widget_btn_off"
        android:gravity="center" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Lights" android:textColor="#F4F6FA" android:textSize="13sp" android:textStyle="bold"
            android:singleLine="true" />
        <TextView android:id="@+id/w_lights_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="–" android:textColor="#B6BFCC" android:textSize="12sp" android:singleLine="true" />
    </LinearLayout>
</LinearLayout>
