<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_dot" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textColor="#F2A93B" android:textSize="13sp" android:paddingEnd="8dp" />
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Waiting for the router" android:textColor="#F4F6FA"
            android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
        <ImageView android:id="@+id/w_refresh" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="9dp" android:src="@drawable/ic_widget_refresh" android:contentDescription="Refresh" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingEnd="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_devices" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="–" android:textColor="#F4F6FA" android:textSize="20sp" android:textStyle="bold"
                android:singleLine="true" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Devices" android:textColor="#B6BFCC" android:textSize="12sp" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_down" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="–" android:textColor="#F4F6FA" android:textSize="20sp" android:textStyle="bold"
                android:singleLine="true" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Download" android:textColor="#B6BFCC" android:textSize="12sp" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_up" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="–" android:textColor="#F4F6FA" android:textSize="20sp" android:textStyle="bold"
                android:singleLine="true" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Upload" android:textColor="#B6BFCC" android:textSize="12sp" android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingEnd="6dp">
        <TextView android:id="@+id/w_footer" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="" android:textColor="#B6BFCC" android:textSize="12sp"
            android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#B6BFCC" android:textSize="12sp" android:singleLine="true"
            android:paddingStart="8dp" />
    </LinearLayout>
</LinearLayout>
